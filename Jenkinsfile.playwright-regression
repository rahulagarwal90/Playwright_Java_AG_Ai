pipeline {
    agent any

    tools {
        maven 'Maven 3.9' // Maps to local Maven 3.9 configuration
        jdk 'JDK 21'      // Maps to local OpenJDK 21 configuration
    }

    parameters {
        choice(name: 'BROWSER', choices: ['chrome', 'firefox', 'webkit'], description: 'Select the browser for test execution')
        string(name: 'TAGS', defaultValue: '', description: 'Enter the Cucumber tags to execute (e.g., @SauceDemo). Leave empty to execute ALL tests.')
        string(name: 'WORKERS', defaultValue: '2', description: 'Number of parallel workers')
    }

    triggers {
        cron('H 02 * * *') // Scheduled nightly run at 2 AM
    }

    environment {
        // Defensively capture parameters with default fallbacks if triggered before parameter initialization
        BROWSER = "${params.BROWSER ?: 'chrome'}"
        TAGS    = "${params.TAGS ?: ''}"
        WORKERS = "${params.WORKERS ?: '2'}"
    }

    stages {
        stage('Install Playwright Browsers') {
            steps {
                script {
                    echo "Preparing Playwright binaries and driver dependencies for browser: ${env.BROWSER}..."
                    // Target ONLY the playwright-tests module using the project list (-pl) flag
                    if (isUnix()) {
                        sh 'mvn -pl playwright-tests exec:java -e -Dexec.mainClass="com.microsoft.playwright.CLI" -Dexec.args="install --with-deps"'
                    } else {
                        bat 'mvn -pl playwright-tests exec:java -e -Dexec.mainClass="com.microsoft.playwright.CLI" -Dexec.args="install --with-deps"'
                    }
                }
            }
        }
        
        stage('Execute Playwright Suites') {
            steps {
                script {
                    catchError(buildResult: 'FAILURE', stageResult: 'FAILURE') {
                        // Defensively handle null parameters if triggered before parameter initialization (first run)
                        String browserParam = (env.BROWSER != null && env.BROWSER.trim() != "null" && env.BROWSER.trim() != "") ? env.BROWSER.trim() : "chrome"
                        String workersParam = (env.WORKERS != null && env.WORKERS.trim() != "null" && env.WORKERS.trim() != "") ? env.WORKERS.trim() : "2"
                        String tagParam = (env.TAGS != null && env.TAGS.trim() != "null") ? env.TAGS.trim() : ""

                        String tagArg = ""
                        if (tagParam != "") {
                            tagArg = "-Dcucumber.filter.tags=\"${tagParam}\""
                            echo "Starting headless Playwright test run using browser: ${browserParam}, filtering by tags: ${tagParam}, workers: ${workersParam}..."
                        } else {
                            echo "Starting headless Playwright test run using browser: ${browserParam}, executing ALL tests (no tag filter), workers: ${workersParam}..."
                        }

                        // Execute browser suites headlessly targeting only the playwright-tests sub-module
                        if (isUnix()) {
                            sh "mvn -pl playwright-tests clean test -Dbrowser.headless=true -Dbrowser=${browserParam} ${tagArg} -Dworkers=${workersParam}"
                        } else {
                            bat "mvn -pl playwright-tests clean test -Dbrowser.headless=true -Dbrowser=${browserParam} ${tagArg} -Dworkers=${workersParam}"
                        }
                    }
                }
            }
        }

        stage('Heal Broken Locators') {
            when {
                expression { currentBuild.currentResult == 'FAILURE' }
            }
            // GITHUB_REPOSITORY/CHANGE_ID/GITHUB_TOKEN below are placeholders only, to satisfy
            // HealOrchestrator.isPipelineContext()'s presence check (this is a scheduled/branch
            // build, not a real GitHub PR) - only AI_HEALER_GITHUB_TOKEN is real and load-bearing.
            environment {
                GITHUB_REPOSITORY = 'rahulagarwal90/Playwright_Java_AG_Ai'
                CHANGE_ID = 'regression'
                GITHUB_TOKEN = 'placeholder-not-used-by-healer'
                AI_HEALER_GITHUB_TOKEN = credentials('github-Ai-Healer-token')
                // Jenkins never sees the gitignored local ai-healer/config.properties, so set
                // OLLAMA_MODEL explicitly here to keep Jenkins and local runs on the same model
                // deliberately (see ai-healer/config.properties.example).
                OLLAMA_MODEL = 'qwen3-coder:30b'
            }
            steps {
                script {
                    if (isUnix()) {
                        sh 'mvn -pl ai-healer compile exec:java -Dexec.mainClass="com.ai.healer.HealOrchestrator"'
                    } else {
                        bat 'mvn -pl ai-healer compile exec:java -Dexec.mainClass="com.ai.healer.HealOrchestrator"'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                echo "Archiving test execution results and artifacts..."
                
                // Publish standard JUnit XML test results
                junit testResults: 'playwright-tests/target/surefire-reports/*.xml', allowEmptyResults: true
                
                // Archive cucumber execution media assets (Videos, Screenshots, Traces) out of playwright-tests target directory
                archiveArtifacts artifacts: 'playwright-tests/target/videos/**/*, playwright-tests/target/screenshots/**/*, playwright-tests/target/traces/**/*', allowEmptyArchive: true

                // Archive the AI Healer's run report, tolerant of it not existing on a clean-pass run
                archiveArtifacts artifacts: 'ai-healer/target/healer-run-report.json', allowEmptyArchive: true

                // Publish Allure Report (Using the installed Allure Jenkins Plugin) wrapped in try-catch
                try {
                    allure includeProperties: false, results: [[path: 'playwright-tests/target/allure-results']]
                    echo "Allure Interactive Report URL: ${env.BUILD_URL}allure/"
                } catch (Exception e) {
                    echo "[WARN] Allure Report generation skipped because Allure CLI is not configured in Jenkins Tools: ${e.message}"
                    echo "[HELP] To fix this, go to Manage Jenkins -> Tools -> Allure Commandline and configure an Allure CLI installation named 'allure'."
                }

                // Print direct URLs to the reports in the console output
                echo "=================================================="
                echo "                  TEST REPORTS                    "
                echo "=================================================="
                echo "JUnit Test Report URL: ${env.BUILD_URL}testReport/"
                echo "AI Healer Report: ${env.BUILD_URL}artifact/ai-healer/target/healer-run-report.json"
                echo "=================================================="
            }
        }
    }
}
