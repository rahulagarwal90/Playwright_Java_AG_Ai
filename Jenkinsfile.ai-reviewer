// Checks whether this PR carries HealerPullRequestCreator's "ai-healer-generated" label (see
// ai-healer's com.ai.healer.github.HealerPullRequestCreator, which applies it via the GitHub REST
// API's "Add labels to an issue" endpoint on every PR it creates) - a live API check made at
// review time, so it can never go stale the way the CHANGE_BRANCH-prefix check alone could: a heal
// branch forks from whatever Jenkinsfile.ai-reviewer version was on main at that moment, so a fix
// landing on main afterward would never reach an already-forked branch's own PR review (this
// happened for real on PR #75). The label lives on the PR itself, not the branch, so it's visible
// regardless of which Jenkinsfile version any given branch happens to carry.
// Fails safe: any error talking to the API (network hiccup, unexpected response shape) is logged
// and treated as "no label", falling back to the CHANGE_BRANCH-prefix check below rather than
// failing the whole post-action.
def hasHealLabel() {
    if (!env.CHANGE_ID?.trim()) {
        return false
    }
    try {
        def response = sh(
            script: '''
                curl -s -H "Authorization: Bearer $GITHUB_TOKEN" \
                     -H "Accept: application/vnd.github.v3+json" \
                     "https://api.github.com/repos/$GITHUB_REPOSITORY/issues/$GITHUB_PR_NUMBER/labels"
            ''',
            returnStdout: true
        ).trim()
        return response.contains('"name":"ai-healer-generated"') || response.contains('"name": "ai-healer-generated"')
    } catch (Exception ex) {
        echo "[WARN] Could not fetch PR #${env.CHANGE_ID} labels to check for 'ai-healer-generated': ${ex.message}"
        return false
    }
}

// Third independent signal: queries the PR itself via GET /repos/.../pulls/$GITHUB_PR_NUMBER
// (not the labels endpoint - this only needs read access, sidestepping any Issues:write
// permission question the label endpoint has) and checks its head branch ref and title. Neither
// the label (permission-dependent - see hasHealLabel()) nor CHANGE_BRANCH alone (proven fragile -
// forks from whatever Jenkinsfile version was on main at fork time, see hasHealLabel()'s comment)
// is fully reliable on its own, so this is a third, independently-sourced check rather than a
// replacement for either. Fails safe: any error talking to the API is logged and treated as "not
// a heal PR" here, falling through to the other two signals rather than failing the post-action.
def isHealPrByPullsApi() {
    if (!env.CHANGE_ID?.trim()) {
        return false
    }
    try {
        def response = sh(
            script: '''
                curl -s -H "Authorization: Bearer $GITHUB_TOKEN" \
                     -H "Accept: application/vnd.github.v3+json" \
                     "https://api.github.com/repos/$GITHUB_REPOSITORY/pulls/$GITHUB_PR_NUMBER"
            ''',
            returnStdout: true
        ).trim()
        def headRefIsHeal = response =~ /"ref"\s*:\s*"heal\//
        def titleIsAiHealer = response =~ /"title"\s*:\s*"AI Healer:/
        return headRefIsHeal.find() || titleIsAiHealer.find()
    } catch (Exception ex) {
        echo "[WARN] Could not fetch PR #${env.CHANGE_ID} details to check head ref/title: ${ex.message}"
        return false
    }
}

pipeline {
    agent any

    tools {
        maven 'Maven 3.9' // Maps to local Maven 3.9 configuration
        jdk 'JDK 21'      // Maps to local OpenJDK 21 configuration
    }

    environment {
        // Securely inject the GitHub Personal Access Token from Jenkins Credentials Manager
        GITHUB_TOKEN = credentials('github-pr-token')
        
        // Populate standard GitHub PR context variables for local git code reviewer.
        // Jenkins Multibranch Pipelines automatically inject CHANGE_ID, CHANGE_URL, and CHANGE_AUTHOR.
        GITHUB_REPOSITORY = "rahulagarwal90/Playwright_Java_AG_Ai"
        GITHUB_PR_NUMBER  = "${env.CHANGE_ID}"
        // Name of the regression pipeline job to trigger after PR AI review runs.
        REGRESSION_JOB_NAME = 'playwright-regression-suite'
        // Jenkins never sees the gitignored local ai-reviewer/config.properties, so set
        // OLLAMA_MODEL explicitly here to keep Jenkins and local runs on the same model
        // deliberately (see ai-reviewer/config.properties.example).
        OLLAMA_MODEL = 'qwen3-coder:30b'
    }

    stages {
        stage('Verify Ollama Engine Availability') {
            steps {
                script {
                    echo "Checking local Ollama service endpoint at http://localhost:11434..."
                    if (isUnix()) {
                        sh '''
                            curl -s -I http://localhost:11434 > /dev/null \
                            || (echo "[ERROR] Ollama runtime is not reachable at http://localhost:11434. Please start it on the host." && exit 1)
                        '''
                    } else {
                        bat '''
                            powershell -Command "try { $response = Invoke-WebRequest -Uri http://localhost:11434 -Method Head -UseBasicParsing; if ($response.StatusCode -ne 200) { exit 1 } } catch { exit 1 }" \
                            || (echo [ERROR] Ollama runtime is not reachable at http://localhost:11434. Please start it on the host. && exit /b 1)
                        '''
                    }
                    echo "Ollama service is up and running."
                }
            }
        }

        stage('Execute AI Review Gate') {
            steps {
                script {
                    echo "Triggering AI Reviewer on module context 'ai-reviewer'..."
                    // Execute only the AI Reviewer using the strict project root context pathing
                    if (isUnix()) {
                        sh 'mvn -pl ai-reviewer clean compile exec:java -Dexec.mainClass="com.ai.reviewer.LocalCodeReviewer"'
                    } else {
                        bat 'mvn -pl ai-reviewer clean compile exec:java -Dexec.mainClass="com.ai.reviewer.LocalCodeReviewer"'
                    }
                }
            }
        }
    }

    post {
        always {
            script {
                // Three independent signals decide this is a heal PR - any one is sufficient to skip:
                // 1) hasHealLabel() - the "ai-healer-generated" label, checked live via the GitHub
                //    API (see hasHealLabel() above for why this is a non-stale signal, but
                //    permission-dependent - it needs Issues:write on the token);
                // 2) CHANGE_BRANCH (the PR's source branch, injected by the same Jenkins
                //    Multibranch/GitHub Branch Source mechanism as CHANGE_ID, only set in PR build
                //    context) starting with heal/ - proven fragile on its own (see hasHealLabel()'s
                //    comment re: PR #75), kept as one signal among several rather than removed;
                // 3) isHealPrByPullsApi() - a live, read-only GitHub API check of the PR's own head
                //    ref/title, sidestepping the label endpoint's permission question entirely.
                // Any single true signal is enough, so a permission gap or staleness in one never
                // defeats the others.
                def isHealPr = env.CHANGE_ID?.trim() &&
                        (hasHealLabel() || env.CHANGE_BRANCH?.startsWith('heal/') || isHealPrByPullsApi())
                if (isHealPr) {
                    echo "[INFO] PR #${env.CHANGE_ID} (branch '${env.CHANGE_BRANCH}') is an AiHealer PR; skipping regression pipeline trigger to avoid a heal-PR review/regression loop."
                } else if (env.CHANGE_ID?.trim()) {
                    echo "[INFO] Triggering regression pipeline '${env.REGRESSION_JOB_NAME}' for PR #${env.CHANGE_ID}."
                    try {
                        build job: env.REGRESSION_JOB_NAME,
                              wait: false,
                              propagate: false,
                              parameters: [
                                  string(name: 'BROWSER', value: 'chrome'),
                                  string(name: 'TAGS', value: ''),
                                  string(name: 'WORKERS', value: '2')
                              ]
                    } catch (Exception ex) {
                        echo "[WARN] Could not trigger regression pipeline '${env.REGRESSION_JOB_NAME}': ${ex.message}"
                    }
                } else {
                    echo "[INFO] Not a PR context; skipping regression pipeline trigger."
                }
            }
        }
        success {
            echo "[INFO] AI Code Quality Gate passed successfully. Pull Request meets standards."
        }
        failure {
            echo "[ERROR] AI Code Quality Gate failed or errors occurred during execution."
        }
    }
}
